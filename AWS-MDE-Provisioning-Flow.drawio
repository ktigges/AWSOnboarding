<mxfile host="app.diagrams.net" agent="GitHub Copilot">
  <diagram id="aws-mde-provisioning" name="AWS MDE Provisioning Flow">
    <mxGraphModel dx="1925" dy="1096" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=25;fontStyle=1;fontColor=#16324F;" value="AWS EC2 to Microsoft Defender for Endpoint and Entra Dynamic Groups" vertex="1">
          <mxGeometry height="45" width="1250" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#52606D;" value="Provisioning summary - Linux custom AMI and Windows Server 2022 default AWS image" vertex="1">
          <mxGeometry height="30" width="1000" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="pipeline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#101820;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Segoe UI;fontSize=15;" value="Run Pipeline to Provision EC2 Instance" vertex="1">
          <mxGeometry height="120" width="250" x="70" y="140" as="geometry" />
        </mxCell>
        <mxCell id="choice" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#B46900;strokeWidth=2;fontFamily=Segoe UI;fontSize=15;fontStyle=1;" value="Platform" vertex="1">
          <mxGeometry height="90" width="115" x="340" y="155" as="geometry" />
        </mxCell>
        <mxCell id="linuxLane" parent="1" style="swimlane;html=1;horizontal=1;startSize=34;rounded=0;fillColor=#F1F8E9;swimlaneFillColor=#FFFFFF;strokeColor=#4F7D24;strokeWidth=2;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#315314;" value="LINUX - CUSTOM AMAZON LINUX 2023 AMI" vertex="1">
          <mxGeometry height="325" width="820" x="500" y="105" as="geometry" />
        </mxCell>
        <mxCell id="linuxAmi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4F7D24;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;align=left;spacingLeft=10;" value="1. Custom Linux AMI&lt;br&gt;&lt;br&gt;&lt;b&gt;Amazon Linux does not include MDE by default&lt;/b&gt;&lt;br&gt;&lt;br&gt;Custom image includes the MDE package in an un-onboarded state&lt;br&gt;&lt;br&gt;Staged mdatp_managed.json template is rendered during provisioning" vertex="1">
          <mxGeometry height="205" width="220" x="530" y="165" as="geometry" />
        </mxCell>
        <mxCell id="linuxTf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C28A00;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;align=left;spacingLeft=10;" value="2. Provision Linux EC2&lt;br&gt;&lt;br&gt;Terraform creates the instance from the custom AMI&lt;br&gt;&lt;br&gt;IAM, private onboarding content, and SSM automation are attached" vertex="1">
          <mxGeometry height="205" width="230" x="785" y="165" as="geometry" />
        </mxCell>
        <mxCell id="linuxSsm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;align=left;spacingLeft=10;" value="3. SSM configures and onboards&lt;br&gt;&lt;br&gt;Render mdatp_managed.json&lt;br&gt;Apply protection settings + exclusions&lt;br&gt;Set MDE GROUP tag&lt;br&gt;&lt;b&gt;LINUX-TAG&lt;/b&gt;&lt;br&gt;Run tenant onboarding script&lt;br&gt;Start and verify mdatp" vertex="1">
          <mxGeometry height="205" width="235" x="1050" y="165" as="geometry" />
        </mxCell>
        <mxCell id="linuxNote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8A949E;dashed=1;fontFamily=Segoe UI;fontSize=12;fontStyle=2;" value="The custom AMI supplies MDE; tenant onboarding, tagging, and active policy are applied only when the EC2 instance is provisioned." vertex="1">
          <mxGeometry height="35" width="755" x="530" y="382" as="geometry" />
        </mxCell>
        <mxCell id="windowsLane" parent="1" style="swimlane;html=1;horizontal=1;startSize=34;rounded=0;fillColor=#EAF4FF;swimlaneFillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#005A9E;" value="WINDOWS - AWS DEFAULT WINDOWS SERVER 2022 IMAGE" vertex="1">
          <mxGeometry height="325" width="820" x="500" y="465" as="geometry" />
        </mxCell>
        <mxCell id="winAmi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4FF;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;align=left;spacingLeft=10;" value="1. Default Windows Server Image&lt;br&gt;&lt;br&gt;&lt;b&gt;Windows Server 2022 already includes Defender Antivirus and the MDE sensor&lt;/b&gt;&lt;br&gt;&lt;br&gt;No custom Windows AMI is required" vertex="1">
          <mxGeometry height="205" width="220" x="530" y="525" as="geometry" />
        </mxCell>
        <mxCell id="winTf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#C28A00;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;align=left;spacingLeft=10;" value="2. Provision Windows EC2&lt;br&gt;&lt;br&gt;Terraform creates the instance from the current AWS Windows Server image&lt;br&gt;&lt;br&gt;IAM, private onboarding content, and SSM automation are attached" vertex="1">
          <mxGeometry height="205" width="230" x="785" y="525" as="geometry" />
        </mxCell>
        <mxCell id="winSsm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDFA;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;align=left;spacingLeft=9;spacingRight=9;" value="3. SSM configures and onboards&lt;br&gt;&lt;br&gt;Apply Defender settings + exclusions&lt;br&gt;Write REG_SZ &lt;b&gt;Group&lt;/b&gt;:&lt;br&gt;HKLM\SOFTWARE\Policies\Microsoft\&lt;br&gt;Windows Advanced Threat Protection\DeviceTagging&lt;br&gt;Value: &lt;b&gt;WINDOWS-TAG&lt;/b&gt;&lt;br&gt;Run onboarding CMD; verify Sense + WinDefend; reboot once to publish tag" vertex="1">
          <mxGeometry height="215" width="270" x="1050" y="520" as="geometry" />
        </mxCell>
        <mxCell id="winNote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#8A949E;dashed=1;fontFamily=Segoe UI;fontSize=12;fontStyle=2;" value="Windows uses the native sensor. The registry GROUP tag is read by MDE as RegistryDeviceTag; reboot accelerates publication." vertex="1">
          <mxGeometry height="35" width="755" x="530" y="742" as="geometry" />
        </mxCell>
        <mxCell id="mde" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontStyle=1;" value="Microsoft Defender for Endpoint&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;DeviceInfo reports AadDeviceId + RegistryDeviceTag&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="300" x="1380" y="205" as="geometry" />
        </mxCell>
        <mxCell id="worker" parent="1" style="swimlane;html=1;horizontal=1;startSize=38;rounded=0;fillColor=#EAF4FF;swimlaneFillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#005A9E;" value="WORKER" vertex="1">
          <mxGeometry height="410" width="340" x="1360" y="330" as="geometry" />
        </mxCell>
        <mxCell id="hunt" parent="worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#8A5B00;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;" value="Microsoft Graph Advanced Hunting&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Read latest DeviceInfo row and allowed AWS pilot tags&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="300" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="func" parent="worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;strokeWidth=2;fontColor=#FFFFFF;fontFamily=Segoe UI;fontSize=14;fontStyle=1;" value="Azure Function processing&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Configurable schedule + managed identity&lt;br&gt;Match Entra by AadDeviceId; exact hostname fallback&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="300" x="20" y="165" as="geometry" />
        </mxCell>
        <mxCell id="entra" parent="worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3EDFA;strokeColor=#5C2D91;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontStyle=1;" value="Microsoft Entra device update&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Write MDE tag to &lt;b&gt;extensionAttribute1&lt;/b&gt;&lt;br&gt;Verify read-back&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="20" y="290" as="geometry" />
        </mxCell>
        <mxCell id="group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CC;strokeColor=#D36B00;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontStyle=1;" value="Entra dynamic device group&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Membership rule uses extensionAttribute1&lt;br&gt;Linux and Windows policies can now be assigned&lt;/font&gt;" vertex="1">
          <mxGeometry height="95" width="300" x="1380" y="790" as="geometry" />
